---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import IngredientList from '../../components/IngredientList.jsx';
import RelatedRecipes from '../../components/RelatedRecipes.astro';
import CookMode from '../../components/CookMode.jsx';
import SousChef from '../../components/SousChef.jsx';

export async function getStaticPaths() {
	const recipes = await getCollection('recipes');
	return recipes.map((recipe) => ({
		params: { slug: recipe.id },
		props: recipe,
	}));
}

type Props = CollectionEntry<'recipes'>;

const recipe = Astro.props;
const { Content } = await render(recipe);

// Calculate total time
const totalTime = (recipe.data.prepTime || 0) + (recipe.data.cookTime || 0);

// Format duration for ISO 8601
const formatDuration = (minutes: number) => {
	if (!minutes) return undefined;
	const hours = Math.floor(minutes / 60);
	const mins = minutes % 60;
	let duration = 'PT';
	if (hours > 0) duration += `${hours}H`;
	if (mins > 0) duration += `${mins}M`;
	return duration;
};

// Build JSON-LD schema
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Recipe',
	name: recipe.data.title,
	description: recipe.data.description,
	prepTime: formatDuration(recipe.data.prepTime),
	cookTime: formatDuration(recipe.data.cookTime),
	totalTime: formatDuration(totalTime),
	recipeYield: `${recipe.data.baseServings} servings`,
	recipeCategory: recipe.data.mealType,
	recipeCuisine: recipe.data.cuisine,
	recipeIngredient: recipe.data.ingredients.map(
		(ing: any) => `${ing.quantity} ${ing.unit} ${ing.name}${ing.notes ? ` (${ing.notes})` : ''}`
	),
	...(recipe.data.rating && { aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: recipe.data.rating,
		bestRating: '5',
	}}),
};

const printUrl = `/recipe/${recipe.id}.print`;
const recipeUrl = `https://chefs-hand.com/recipe/${recipe.id}`;
const shareText = `Check out this recipe: ${recipe.data.title}`;
---

<html lang="en">
	<head>
		<BaseHead title={recipe.data.title} description={recipe.data.description} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="bg-base-100 text-base-content selection:bg-primary/20">
		<Header />
		
		<main class="min-h-screen">
			{/* Recipe Hero Entry */}
			<section class="container mx-auto px-6 py-12 lg:py-16 border-b border-base-300">
				<div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-start">
					<div class="lg:w-2/3 space-y-8">
						<div class="space-y-6">
							<nav class="flex items-center gap-2 text-[10px] uppercase tracking-[0.4em] font-bold">
								<a href="/recipes" class="text-base-content/50 hover:text-primary transition-colors">Recipes</a>
								<span class="text-base-content/20">/</span>
								<span class="text-primary">{recipe.data.mealType}</span>
							</nav>
							<h1 class="text-5xl lg:text-7xl font-bold font-serif leading-[0.9] tracking-tight">
								{recipe.data.title}
							</h1>
							<div class="h-1 w-24 bg-primary my-8"></div>
							<p class="text-2xl text-base-content/80 leading-relaxed max-w-2xl font-serif italic">
								{recipe.data.description}
							</p>
						</div>

						{recipe.data.dietaryTags && recipe.data.dietaryTags.length > 0 && (
							<div class="flex flex-wrap gap-3">
								{recipe.data.dietaryTags.map((tag: string) => (
									<span class="border border-base-300 text-base-content text-[10px] font-bold uppercase tracking-widest px-4 py-2">
										{tag}
									</span>
								))}
							</div>
						)}

						<div class="flex flex-wrap gap-6 pt-8 border-t border-base-300">
							<button onclick="window.print();" class="inline-block bg-primary text-white font-bold uppercase tracking-widest text-[10px] px-8 py-4 hover:bg-primary/90 transition-colors flex items-center gap-2 cursor-pointer no-print">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
									<path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a60.773 60.773 0 012.56-.047m-2.56.047c.178-.036.357-.071.537-.107m.537.107a60.748 60.748 0 012.56.047M6.72 13.829l-2.02 6.031C4.112 20.867 5.064 21 6.25 21H19.75c1.186 0 2.138-.133 2.55-1.14l-2.02-6.031m-13.08 0l1.07-3.292a60.704 60.704 0 011.927-.856M17.25 13.829l1.07-3.292a60.704 60.704 0 011.927-.856M6.75 18.75h10.5M21 15a.75.75 0 100-1.5.75.75 0 000 1.5M5.25 15a.75.75 0 100-1.5.75.75 0 000 1.5" />
								</svg>
								Print Recipe
							</button>
							<details class="relative">
								<summary class="inline-block border border-base-300 text-base-content font-bold uppercase tracking-widest text-[10px] px-8 py-4 hover:bg-base-200 transition-colors flex items-center gap-2 cursor-pointer list-none">
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
										<path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l4.488-4.488m0 0c.591-.591 1.55-.591 2.142 0l2.85 2.85c.591.591.591 1.55 0 2.142l-4.488 4.488m7.006-4.488l4.488 4.488c.591.591.591 1.55 0 2.142l-2.85 2.85c-.591.591-1.55.591-2.142 0l-4.488-4.488" />
									</svg>
									Share
								</summary>
								<ul class="absolute left-0 top-full bg-base-100 border border-base-300 z-[1] w-52 p-0 mt-2 text-xs uppercase tracking-widest font-bold list-none">
									<li><a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(recipeUrl)}`} target="_blank" class="block px-6 py-4 border-b border-base-300 hover:bg-base-200 transition-colors">Facebook</a></li>
									<li><a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}`} target="_blank" class="block px-6 py-4 border-b border-base-300 hover:bg-base-200 transition-colors">Twitter</a></li>
									<li><a href={`mailto:?subject=${encodeURIComponent(recipe.data.title)}&body=${encodeURIComponent(recipeUrl)}`} class="block px-6 py-4 hover:bg-base-200 transition-colors">Email</a></li>
								</ul>
							</details>
						</div>
					</div>

					<div class="lg:w-1/3 w-full">
						<div class="bg-base-200/50 p-10 border border-base-300 sticky top-24 space-y-8">
							<div class="grid grid-cols-2 gap-px bg-base-300 border border-base-300">
								<div class="p-6 bg-base-100 text-center">
									<p class="text-[10px] uppercase tracking-widest text-base-content/40 font-bold mb-2">Rating</p>
									<p class="text-xl font-bold font-serif flex items-center justify-center gap-1">
										{recipe.data.rating || '—'} <span class="text-primary text-sm">★</span>
									</p>
								</div>
								<div class="p-6 bg-base-100 text-center">
									<p class="text-[10px] uppercase tracking-widest text-base-content/40 font-bold mb-2">Time</p>
									<p class="text-xl font-bold font-serif tabular-nums">{totalTime}m</p>
								</div>
								<div class="p-6 bg-base-100 text-center">
									<p class="text-[10px] uppercase tracking-widest text-base-content/40 font-bold mb-2">Level</p>
									<p class="text-lg font-bold font-serif capitalize">{recipe.data.difficulty}</p>
								</div>
								<div class="p-6 bg-base-100 text-center">
									<p class="text-[10px] uppercase tracking-widest text-base-content/40 font-bold mb-2">Yield</p>
									<p class="text-xl font-bold font-serif tabular-nums">{recipe.data.baseServings}</p>
								</div>
							</div>
							
							<div class="pt-8 border-t border-base-300">
								<p class="text-sm text-base-content/60 leading-relaxed font-serif italic text-center">
									"Every recipe in Chef's Hand is kitchen-tested and scaled to your needs."
								</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			{/* Recipe Content Section */}
			<section class="py-16 container mx-auto px-6">
				<div class="grid lg:grid-cols-[1fr_2fr] gap-16 items-start">
					{/* Ingredients Column */}
					<div class="lg:sticky lg:top-24">
						<h2 class="text-3xl font-bold font-serif mb-12 uppercase tracking-widest border-b border-base-300 pb-6">
							Ingredients
						</h2>
						<IngredientList ingredients={recipe.data.ingredients} baseServings={recipe.data.baseServings} client:load />

						{recipe.data.nutrition && (
							<div class="mt-16 p-6 border border-base-300 bg-base-200/30 no-print">
								<h3 class="text-xs uppercase tracking-widest font-bold mb-4 border-b border-base-300 pb-2">Nutrition per serving</h3>
								<div class="grid grid-cols-2 gap-x-8 gap-y-3 text-sm font-serif italic">
									<div class="flex justify-between border-b border-base-300/50 pb-1">
										<span class="font-bold font-sans not-italic">Calories</span> <span>{recipe.data.nutrition.calories}</span>
									</div>
									<div class="flex justify-between border-b border-base-300/50 pb-1">
										<span class="font-bold font-sans not-italic">Protein</span> <span>{recipe.data.nutrition.protein}g</span>
									</div>
									<div class="flex justify-between border-b border-base-300/50 pb-1">
										<span class="font-bold font-sans not-italic">Carbs</span> <span>{recipe.data.nutrition.carbs}g</span>
									</div>
									<div class="flex justify-between border-b border-base-300/50 pb-1">
										<span class="font-bold font-sans not-italic">Fat</span> <span>{recipe.data.nutrition.fat}g</span>
									</div>
								</div>
							</div>
						)}
					</div>

					{/* Instructions Column */}
					<div>
						<div class="flex justify-between items-end mb-12 border-b border-base-300 pb-6">
							<h2 class="text-3xl font-bold font-serif uppercase tracking-widest">
								Method
							</h2>
							<CookMode 
								title={recipe.data.title} 
								ingredients={recipe.data.ingredients} 
								baseServings={recipe.data.baseServings}
								totalTime={totalTime} 
								client:load
							>
								<Content />
							</CookMode>
						</div>
						<article class="prose prose-lg md:prose-xl max-w-none">
							<Content />
						</article>

						{/* Related Recipes Footer */}
						<RelatedRecipes currentRecipe={recipe} maxRecipes={3} />
					</div>
				</div>
			</section>
		</main>

		<SousChef client:load />
		<Footer />
	</body>
</html>