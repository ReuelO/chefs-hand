---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`404 - Page Not Found | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-base-100 text-base-content selection:bg-primary/20 flex flex-col min-h-screen">
		<Header />
		
		<main class="flex-1 flex items-center justify-center py-24">
			<div class="container mx-auto px-6 text-center space-y-8 animate-entrance">
				<p class="text-[10px] uppercase tracking-[0.4em] text-primary font-bold">Error 404</p>
				<h1 class="text-6xl lg:text-7xl font-bold font-serif leading-[0.9] tracking-tight">
					Lost in the <br/><span class="italic text-base-content/50">pantry.</span>
				</h1>
				<div class="h-1 w-24 bg-primary mx-auto my-8"></div>
				<p class="text-xl text-base-content/70 leading-relaxed max-w-lg mx-auto font-serif italic">
					We couldn't find the recipe or page you were looking for. It might have been moved, or perhaps it's still in the test kitchen.
				</p>
				<div class="pt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
					<a href="/" class="inline-block bg-primary text-white font-bold uppercase tracking-widest text-xs px-8 py-4 hover:bg-primary/90 transition-colors">
						Return Home
					</a>
					<a href="/recipes" class="inline-block border border-base-300 bg-base-100 text-base-content font-bold uppercase tracking-widest text-xs px-8 py-4 hover:bg-base-200 transition-colors">
						Browse Recipes
					</a>
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>
