---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Group posts by Month and Year
const groupedPosts = posts.reduce((acc, post) => {
	const date = new Date(post.data.pubDate);
	const monthYear = date.toLocaleDateString(undefined, { month: 'long', year: 'numeric' });
	if (!acc[monthYear]) {
		acc[monthYear] = [];
	}
	acc[monthYear].push(post);
	return acc;
}, {});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — Blog`} description={SITE_DESCRIPTION} />
	</head>
	<body class="selection:bg-primary/20 bg-base-100 text-base-content">
		<Header />
		<main>
			{/* Editorial Header */}
			<section class="py-12 lg:py-16 border-b border-base-300">
				<div class="container mx-auto px-6">
					<div class="max-w-4xl mx-auto space-y-6 text-center">
						<p class="text-[10px] uppercase tracking-[0.4em] text-primary font-bold">The Blog</p>
						<h1 class="text-5xl lg:text-6xl font-bold font-serif leading-[0.9] tracking-tight">
							Thoughts from the <br/> <span class="italic text-base-content/50">cutting board</span>.
						</h1>
						<p class="text-xl text-base-content/80 leading-relaxed font-serif italic max-w-2xl mx-auto mt-6">
							A personal archive of kitchen experiments and stories behind the recipes.
						</p>
					</div>
				</div>
			</section>

			{/* Posts List Layout (Compact File Explorer View) */}
			<section class="container mx-auto px-6 py-12">
				<div class="max-w-5xl mx-auto">
					{posts.length > 0 ? (
						Object.entries(groupedPosts).map(([monthYear, monthPosts]) => (
							<div class="mb-12 last:mb-0">
								<h2 class="text-xs font-bold uppercase tracking-[0.2em] text-base-content/50 mb-2 px-4 sticky top-16 bg-base-100/90 backdrop-blur py-3 z-10 border-y border-base-200 shadow-sm">
									{monthYear}
								</h2>
								<div class="divide-y divide-base-200/50">
									{monthPosts.map((post) => (
										<article class="group py-6">
											<a class="flex flex-col sm:flex-row sm:items-center gap-6 sm:gap-8 transition-colors" href={`/blog/${post.id}/`}>
												<div class="w-full sm:w-40 aspect-[4/3] flex-none overflow-hidden bg-base-200 border border-base-300">
													{post.data.heroImage ? (
														<img class="w-full h-full object-cover filter contrast-[1.1] group-hover:scale-105 transition-transform duration-700 ease-out" src={post.data.heroImage} alt={post.data.title} />
													) : (
														<div class="w-full h-full flex items-center justify-center text-base-content/20 font-serif italic text-sm">No Image</div>
													)}
												</div>
												<div class="flex-1 flex flex-col justify-center min-w-0 space-y-2">
													<div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-2">
														<h3 class="text-2xl md:text-3xl font-bold font-serif leading-tight group-hover:text-primary transition-colors">{post.data.title}</h3>
														<p class="text-[10px] uppercase tracking-widest text-base-content/40 font-bold whitespace-nowrap">
															{new Date(post.data.pubDate).toLocaleDateString(undefined, { day: 'numeric', month: 'short' })}
														</p>
													</div>
													<p class="text-base md:text-lg text-base-content/60 font-serif italic line-clamp-2 max-w-2xl">{post.data.description}</p>
												</div>
											</a>
										</article>
									))}
								</div>
							</div>
						))
					) : (
						<div class="py-16 text-center">
							<div class="max-w-lg mx-auto p-8 border border-base-300 bg-base-200/30">
								<h3 class="text-xl font-bold font-serif mb-2">The journal is empty</h3>
								<p class="text-sm text-base-content/60 mb-6 font-serif italic">This section is ready for your blog posts and stories.</p>
								<a href="/blog/post" class="inline-block bg-primary text-white font-bold uppercase tracking-widest text-[10px] px-6 py-3 hover:bg-primary/90 transition-colors">Write the first post</a>
							</div>
						</div>
					)}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
