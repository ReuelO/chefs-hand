---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import preferences from '../../data/preferences.json';

// Fetch all content collections on the server-side for maximum speed
const allRecipes = await getCollection('recipes');
const allPosts = await getCollection('blog');

// Calculate high-end metrics
const totalRecipes = allRecipes.length;
const totalPosts = allPosts.length;
const featuredRecipesCount = allRecipes.filter(r => r.data.featured).length;

// Sort collections by date/title
const sortedRecipes = allRecipes.sort((a, b) => b.id.localeCompare(a.id));
const sortedPosts = allPosts.sort((a, b) => {
  const dateA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
  const dateB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
  return dateB - dateA;
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Admin Dashboard | ${SITE_TITLE}`} description="Chef's Hand Administration Suite" />
    
    <!-- Hidden Security Gate (Redirects unauthorized users to the homepage instantly) -->
    <script is:inline>
      if (localStorage.getItem('admin_authorized') !== 'true') {
        window.location.href = '/';
      }
    </script>
	</head>
	<body class="bg-base-100 text-base-content selection:bg-primary/20 flex flex-col min-h-screen">
		<Header />
		
		<main class="flex-1 container mx-auto px-6 py-12 lg:py-16 space-y-16 animate-entrance">
			<!-- Header -->
			<div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 border-b border-base-300 pb-12">
				<div>
					<p class="text-[10px] uppercase tracking-[0.4em] font-bold text-primary mb-4">Administration</p>
					<h1 class="text-5xl lg:text-6xl font-bold font-serif leading-[0.9] tracking-tight">Dashboard</h1>
					<p class="mt-4 text-lg text-base-content/60 font-serif italic max-w-xl">
						Manage your culinary repository, update recipes, publish stories, and curate featured highlights.
					</p>
				</div>
        <div class="flex flex-wrap gap-4">
          <a href="/recipes/add?admin=true" class="bg-primary text-white font-bold uppercase tracking-widest text-[10px] px-6 py-4 hover:bg-primary/90 transition-colors">
            + New Recipe
          </a>
          <a href="/blog/post?admin=true" class="border border-base-300 bg-base-100 text-base-content font-bold uppercase tracking-widest text-[10px] px-6 py-4 hover:bg-base-200 transition-colors">
            + New Story
          </a>
          <button id="logoutBtn" class="border border-red-200 text-red-600 font-bold uppercase tracking-widest text-[10px] px-6 py-4 hover:bg-red-50 transition-colors cursor-pointer">
            Lock Panel
          </button>
        </div>
			</div>

      <!-- Metrics Row -->
      <section class="grid sm:grid-cols-3 gap-6 lg:gap-12">
        <div class="bg-base-200/30 p-8 border border-base-300 space-y-2">
          <p class="text-[9px] uppercase tracking-[0.3em] font-bold opacity-50">Total Recipes</p>
          <p class="text-4xl font-bold font-serif">{totalRecipes}</p>
        </div>
        <div class="bg-base-200/30 p-8 border border-base-300 space-y-2">
          <p class="text-[9px] uppercase tracking-[0.3em] font-bold opacity-50">Total Stories</p>
          <p class="text-4xl font-bold font-serif">{totalPosts}</p>
        </div>
        <div class="bg-base-200/30 p-8 border border-base-300 space-y-2">
          <p class="text-[9px] uppercase tracking-[0.3em] font-bold opacity-50">Featured Recipes</p>
          <p class="text-4xl font-bold font-serif text-primary">{featuredRecipesCount}</p>
        </div>
      </section>

      <!-- Content Management Section -->
      <section class="space-y-8">
        <!-- Tab Navigation -->
        <div class="flex border-b border-base-300">
          <button id="recipesTab" class="py-4 px-8 border-b-2 border-primary font-bold uppercase tracking-widest text-xs transition-colors cursor-pointer">
            Recipes ({totalRecipes})
          </button>
          <button id="blogTab" class="py-4 px-8 border-b-2 border-transparent text-base-content/50 font-bold uppercase tracking-widest text-xs transition-colors hover:text-base-content cursor-pointer">
            Stories ({totalPosts})
          </button>
          <button id="preferencesTab" class="py-4 px-8 border-b-2 border-transparent text-base-content/50 font-bold uppercase tracking-widest text-xs transition-colors hover:text-base-content cursor-pointer">
            Preferences
          </button>
        </div>

        <!-- Recipes Tab Pane (High-End Flex Grid, immune to layout shifts) -->
        <div id="recipesPanel" class="space-y-4">
          <div class="space-y-4 font-serif">
            {sortedRecipes.map(recipe => (
              <div class="flex flex-col md:flex-row items-start md:items-center justify-between p-6 border border-base-300 bg-base-200/10 hover:bg-base-200/30 transition-colors gap-4">
                <div class="space-y-1">
                  <span class="text-[9px] uppercase tracking-[0.2em] font-sans font-bold text-primary">
                    {recipe.data.cuisine || 'Generic'} • {recipe.data.mealType || 'Recipe'}
                  </span>
                  <a href={`/recipe/${recipe.id}`} class="block font-bold hover:text-primary transition-colors text-xl leading-tight">
                    {recipe.data.title}
                  </a>
                  <p class="text-xs text-base-content/40 font-mono mt-0.5">{recipe.id}.md</p>
                </div>
                <div class="flex items-center gap-6 font-sans text-xs w-full md:w-auto justify-between md:justify-end">
                  {recipe.data.featured ? (
                    <span class="bg-primary/10 text-primary border border-primary/20 px-3 py-1 uppercase tracking-widest text-[9px] font-bold">
                      Featured
                    </span>
                  ) : (
                    <span class="bg-base-200 text-base-content/60 border border-base-300 px-3 py-1 uppercase tracking-widest text-[9px] font-bold">
                      Standard
                    </span>
                  )}
                  <div class="space-x-4">
                    <a href={`/recipes/add?edit=${recipe.id}`} class="text-primary font-bold hover:underline">Edit</a>
                    <button data-delete-id={recipe.id} data-collection="recipes" class="text-red-600 font-bold hover:underline cursor-pointer delete-btn">Delete</button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Blog Posts Tab Pane (Hidden by Default) -->
        <div id="blogPanel" class="space-y-4 hidden">
          <div class="space-y-4 font-serif">
            {sortedPosts.map(post => (
              <div class="flex flex-col md:flex-row items-start md:items-center justify-between p-6 border border-base-300 bg-base-200/10 hover:bg-base-200/30 transition-colors gap-4">
                <div class="space-y-1">
                  <span class="text-[9px] uppercase tracking-[0.2em] font-sans font-bold text-base-content/40">
                    {post.data.pubDate ? new Date(post.data.pubDate).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : 'Draft'}
                  </span>
                  <a href={`/blog/${post.id}`} class="block font-bold hover:text-primary transition-colors text-xl leading-tight">
                    {post.data.title}
                  </a>
                  <p class="text-xs text-base-content/40 font-mono mt-0.5">{post.id}.md</p>
                </div>
                <div class="flex items-center gap-6 font-sans text-xs w-full md:w-auto justify-end">
                  <div class="space-x-4">
                    <a href={`/blog/post?edit=${post.id}`} class="text-primary font-bold hover:underline">Edit</a>
                    <button data-delete-id={post.id} data-collection="blog" class="text-red-600 font-bold hover:underline cursor-pointer delete-btn">Delete</button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Preferences Tab Pane (Hidden by Default) -->
        <div id="preferencesPanel" class="hidden animate-entrance">
          <div class="max-w-xl border border-base-300 bg-base-200/10 p-8 space-y-6">
            <h2 class="text-2xl font-bold font-serif border-b border-base-300 pb-4">Theme & Style Colors</h2>
            
            <div class="space-y-4">
              <label class="block text-xs uppercase tracking-widest font-bold opacity-60">Accent Theme Preset</label>
              <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
                <button type="button" class="color-preset-btn flex flex-col items-center gap-1 border border-base-300 p-3 hover:bg-base-200/50 cursor-pointer" data-color="#d4311e" data-color-dark="#b82919">
                  <div class="w-6 h-6 rounded-full bg-[#d4311e]"></div>
                  <span class="text-[8px] uppercase tracking-wider font-bold">Crimson</span>
                </button>
                <button type="button" class="color-preset-btn flex flex-col items-center gap-1 border border-base-300 p-3 hover:bg-base-200/50 cursor-pointer" data-color="#2E5A44" data-color-dark="#1f3e2e">
                  <div class="w-6 h-6 rounded-full bg-[#2E5A44]"></div>
                  <span class="text-[8px] uppercase tracking-wider font-bold">Sage</span>
                </button>
                <button type="button" class="color-preset-btn flex flex-col items-center gap-1 border border-base-300 p-3 hover:bg-base-200/50 cursor-pointer" data-color="#132435" data-color-dark="#0b1621">
                  <div class="w-6 h-6 rounded-full bg-[#132435]"></div>
                  <span class="text-[8px] uppercase tracking-wider font-bold">Caviar</span>
                </button>
                <button type="button" class="color-preset-btn flex flex-col items-center gap-1 border border-base-300 p-3 hover:bg-base-200/50 cursor-pointer" data-color="#C8821D" data-color-dark="#a36916">
                  <div class="w-6 h-6 rounded-full bg-[#C8821D]"></div>
                  <span class="text-[8px] uppercase tracking-wider font-bold">Ochre</span>
                </button>
                <button type="button" class="color-preset-btn flex flex-col items-center gap-1 border border-base-300 p-3 hover:bg-base-200/50 cursor-pointer" data-color="#5C253B" data-color-dark="#441a2b">
                  <div class="w-6 h-6 rounded-full bg-[#5C253B]"></div>
                  <span class="text-[8px] uppercase tracking-wider font-bold">Plum</span>
                </button>
              </div>
            </div>

            <!-- Custom HEX Pickers -->
            <div class="grid grid-cols-2 gap-4">
              <div class="space-y-2">
                <label for="themeColor" class="block text-xs uppercase tracking-widest font-bold opacity-60">Custom Primary HEX</label>
                <input type="text" id="themeColor" class="input font-mono" placeholder="#d4311e" />
              </div>
              <div class="space-y-2">
                <label for="themeColorDark" class="block text-xs uppercase tracking-widest font-bold opacity-60">Custom Dark HEX (Hover)</label>
                <input type="text" id="themeColorDark" class="input font-mono" placeholder="#b82919" />
              </div>
            </div>

            <h2 class="text-2xl font-bold font-serif border-b border-base-300 pb-4 pt-4">Site Typography & Copy</h2>

            <div class="space-y-2">
              <label for="brandSubtitle" class="block text-xs uppercase tracking-widest font-bold opacity-60">Footer Brand Subtitle</label>
              <textarea id="brandSubtitle" class="input h-24" placeholder="A curated kitchen journal..."></textarea>
            </div>

            <div class="space-y-2">
              <label for="featuredTitle" class="block text-xs uppercase tracking-widest font-bold opacity-60">Hero Welcome Title</label>
              <input type="text" id="featuredTitle" class="input" placeholder="Master the technique." />
            </div>

            <div class="pt-4">
              <button id="savePreferencesBtn" class="w-full btn btn-primary py-4 font-bold text-center justify-center">
                Save Preferences
              </button>
            </div>
          </div>
        </div>
      </section>
		</main>

		<Footer />

    <!-- Interactive Client JS for Tabs, CRUD Operations, and Settings -->
    <script define:vars={{ preferences }}>
      document.addEventListener('astro:page-load', () => {
        const recipesTab = document.getElementById('recipesTab');
        const blogTab = document.getElementById('blogTab');
        const preferencesTab = document.getElementById('preferencesTab');

        const recipesPanel = document.getElementById('recipesPanel');
        const blogPanel = document.getElementById('blogPanel');
        const preferencesPanel = document.getElementById('preferencesPanel');

        const logoutBtn = document.getElementById('logoutBtn');

        // Form Inputs for Preferences
        const prefColorInput = document.getElementById('themeColor');
        const prefColorDarkInput = document.getElementById('themeColorDark');
        const prefSubtitleInput = document.getElementById('brandSubtitle');
        const prefTitleInput = document.getElementById('featuredTitle');
        const savePreferencesBtn = document.getElementById('savePreferencesBtn');

        // Prepopulate preferences from server-side definitions
        if (prefColorInput) prefColorInput.value = preferences.themeColor;
        if (prefColorDarkInput) prefColorDarkInput.value = preferences.themeColorDark;
        if (prefSubtitleInput) prefSubtitleInput.value = preferences.brandSubtitle;
        if (prefTitleInput) prefTitleInput.value = preferences.featuredTitle;

        // Color Presets Selection
        document.querySelectorAll('.color-preset-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const color = btn.getAttribute('data-color');
            const colorDark = btn.getAttribute('data-color-dark');
            if (prefColorInput) prefColorInput.value = color;
            if (prefColorDarkInput) prefColorDarkInput.value = colorDark;
            
            // Visual feedback on selected preset
            document.querySelectorAll('.color-preset-btn').forEach(b => b.classList.remove('border-primary'));
            btn.classList.add('border-primary');
          });
        });

        // Tab Navigation Trigger System
        if (recipesTab && blogTab && preferencesTab && recipesPanel && blogPanel && preferencesPanel) {
          recipesTab.addEventListener('click', () => {
            recipesTab.className = 'py-4 px-8 border-b-2 border-primary font-bold uppercase tracking-widest text-xs transition-colors cursor-pointer';
            blogTab.className = 'py-4 px-8 border-b-2 border-transparent text-base-content/50 font-bold uppercase tracking-widest text-xs transition-colors hover:text-base-content cursor-pointer';
            preferencesTab.className = 'py-4 px-8 border-b-2 border-transparent text-base-content/50 font-bold uppercase tracking-widest text-xs transition-colors hover:text-base-content cursor-pointer';
            
            recipesPanel.classList.remove('hidden');
            blogPanel.classList.add('hidden');
            preferencesPanel.classList.add('hidden');
          });

          blogTab.addEventListener('click', () => {
            blogTab.className = 'py-4 px-8 border-b-2 border-primary font-bold uppercase tracking-widest text-xs transition-colors cursor-pointer';
            recipesTab.className = 'py-4 px-8 border-b-2 border-transparent text-base-content/50 font-bold uppercase tracking-widest text-xs transition-colors hover:text-base-content cursor-pointer';
            preferencesTab.className = 'py-4 px-8 border-b-2 border-transparent text-base-content/50 font-bold uppercase tracking-widest text-xs transition-colors hover:text-base-content cursor-pointer';
            
            blogPanel.classList.remove('hidden');
            recipesPanel.classList.add('hidden');
            preferencesPanel.classList.add('hidden');
          });

          preferencesTab.addEventListener('click', () => {
            preferencesTab.className = 'py-4 px-8 border-b-2 border-primary font-bold uppercase tracking-widest text-xs transition-colors cursor-pointer';
            recipesTab.className = 'py-4 px-8 border-b-2 border-transparent text-base-content/50 font-bold uppercase tracking-widest text-xs transition-colors hover:text-base-content cursor-pointer';
            blogTab.className = 'py-4 px-8 border-b-2 border-transparent text-base-content/50 font-bold uppercase tracking-widest text-xs transition-colors hover:text-base-content cursor-pointer';
            
            preferencesPanel.classList.remove('hidden');
            recipesPanel.classList.add('hidden');
            blogPanel.classList.add('hidden');
          });
        }

        // Save Preferences Action
        if (savePreferencesBtn) {
          savePreferencesBtn.addEventListener('click', async () => {
            savePreferencesBtn.textContent = 'Saving Preferences...';
            savePreferencesBtn.disabled = true;

            const updatedPrefs = {
              themeColor: prefColorInput.value.trim() || '#d4311e',
              themeColorDark: prefColorDarkInput.value.trim() || '#b82919',
              brandSubtitle: prefSubtitleInput.value.trim() || 'A curated kitchen journal.',
              featuredTitle: prefTitleInput.value.trim() || 'Master the technique.'
            };

            try {
              const res = await fetch('/api/save-preferences', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(updatedPrefs)
              });

              const result = await res.json();

              if (res.ok && result.success) {
                alert('Site preferences updated successfully.');
                window.location.reload();
              } else {
                throw new Error(result.error || 'Failed to save preferences');
              }
            } catch (err) {
              alert(`Error saving preferences: ${err.message}`);
              savePreferencesBtn.textContent = 'Save Preferences';
              savePreferencesBtn.disabled = false;
            }
          });
        }

        // Logout Panel Button
        if (logoutBtn) {
          logoutBtn.addEventListener('click', () => {
            localStorage.removeItem('admin_authorized');
            window.location.href = '/';
          });
        }

        // Delete Button Logic (Integrated with both Local & GitHub endpoints)
        document.querySelectorAll('.delete-btn').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            const id = btn.getAttribute('data-delete-id');
            const collection = btn.getAttribute('data-collection');
            
            const confirmText = `Are you absolutely sure you want to delete this ${collection === 'recipes' ? 'recipe' : 'story'} ("${id}")? This action is permanent.`;
            
            if (window.confirm(confirmText)) {
              btn.textContent = 'Deleting...';
              btn.setAttribute('disabled', 'true');

              try {
                const res = await fetch(`/api/delete-content?collection=${collection}&id=${id}`, {
                  method: 'DELETE'
                });

                const result = await res.json();

                if (res.ok && result.success) {
                  alert('Content deleted successfully.');
                  window.location.reload();
                } else {
                  throw new Error(result.error || 'Failed to delete content');
                }
              } catch (err) {
                alert(`Error: ${err.message}`);
                btn.textContent = 'Delete';
                btn.removeAttribute('disabled');
              }
            }
          });
        });
      });
    </script>
	</body>
</html>
