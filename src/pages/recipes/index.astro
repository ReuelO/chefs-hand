---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const allRecipes = await getCollection('recipes');

// Extract unique values for filtering
const cuisines = [...new Set(allRecipes.map(r => r.data.cuisine).filter(Boolean))] as string[];
const mealTypes = [...new Set(allRecipes.map(r => r.data.mealType).filter(Boolean))] as string[];
const cookingMethods = [...new Set(allRecipes.map(r => r.data.cookingMethod).filter(Boolean))] as string[];

// Convert recipes to serializable format for client-side search
const recipesData = allRecipes.map(recipe => ({
	id: recipe.id,
	title: recipe.data.title,
	description: recipe.data.description,
	heroImage: recipe.data.heroImage || '/hero-bg.png',
	cuisine: recipe.data.cuisine || '',
	mealType: recipe.data.mealType || '',
	cookingMethod: recipe.data.cookingMethod || '',
	difficulty: recipe.data.difficulty || '',
	rating: recipe.data.rating || 0,
	dietaryTags: recipe.data.dietaryTags || [],
	ingredients: recipe.data.ingredients.map(i => i.name).join(' '),
}));
---

<html lang="en">
	<head>
		<BaseHead title="Browse Recipes" description="Browse and search all recipes by cuisine, meal type, or cooking method." />
	</head>
	<body class="bg-base-100 text-base-content selection:bg-primary/20">
		<Header />
		<main class="min-h-screen">
			<div class="container mx-auto px-6 py-12 lg:py-16 space-y-12">
				{/* Header */}
				<div class="border-b border-base-300 pb-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
					<div>
						<p class="text-[10px] uppercase tracking-[0.4em] font-bold text-primary mb-2">Recipes</p>
						<h1 class="text-4xl lg:text-5xl font-bold font-serif leading-[0.9] tracking-tight">The Archive</h1>
					</div>
					<div class="w-full md:w-1/2 lg:w-1/3">
						<input
							type="text"
							id="search-input"
							placeholder="Search recipes, ingredients, methods..."
							class="input py-3"
						/>
					</div>
				</div>

				<div class="flex flex-col lg:flex-row gap-12 items-start">
					{/* Sidebar Filters */}
					<aside class="w-full lg:w-64 flex-none space-y-12 lg:sticky lg:top-24">
						{cuisines.length > 0 && (
							<div>
								<h2 class="text-xl font-bold font-serif mb-4 border-b border-base-300 pb-2">Cuisine</h2>
								<div class="space-y-2">
									{cuisines.map((cuisine) => {
										const count = allRecipes.filter(r => r.data.cuisine === cuisine).length;
										return (
											<a
												href={`/recipes/cuisine/${cuisine.toLowerCase().replace(/\s+/g, '-')}`}
												class="group flex justify-between items-center py-1 border-b border-base-200 hover:border-primary transition-colors"
											>
												<span class="font-bold uppercase tracking-widest text-[10px] group-hover:text-primary transition-colors">{cuisine}</span>
												<span class="text-[10px] font-bold text-base-content/40 tabular-nums">({count})</span>
											</a>
										);
									})}
								</div>
							</div>
						)}

						{mealTypes.length > 0 && (
							<div>
								<h2 class="text-xl font-bold font-serif mb-4 border-b border-base-300 pb-2">Meal Type</h2>
								<div class="space-y-2">
									{mealTypes.map((mealType) => {
										const count = allRecipes.filter(r => r.data.mealType === mealType).length;
										return (
											<a
												href={`/recipes/meal/${mealType}`}
												class="group flex justify-between items-center py-1 border-b border-base-200 hover:border-primary transition-colors"
											>
												<span class="font-bold uppercase tracking-widest text-[10px] group-hover:text-primary transition-colors">{mealType}</span>
												<span class="text-[10px] font-bold text-base-content/40 tabular-nums">({count})</span>
											</a>
										);
									})}
								</div>
							</div>
						)}

						{cookingMethods.length > 0 && (
							<div>
								<h2 class="text-xl font-bold font-serif mb-4 border-b border-base-300 pb-2">Method</h2>
								<div class="space-y-2">
									{cookingMethods.map((method) => {
										const count = allRecipes.filter(r => r.data.cookingMethod === method).length;
										const methodLabel = method.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
										return (
											<a
												href={`/recipes/method/${method}`}
												class="group flex justify-between items-center py-1 border-b border-base-200 hover:border-primary transition-colors"
											>
												<span class="font-bold uppercase tracking-widest text-[10px] group-hover:text-primary transition-colors">{methodLabel}</span>
												<span class="text-[10px] font-bold text-base-content/40 tabular-nums">({count})</span>
											</a>
										);
									})}
								</div>
							</div>
						)}
					</aside>

					{/* Main Content: Results Grid */}
					<div class="flex-1 w-full" id="results-container">
						<div id="results" class="grid gap-8 grid-cols-1 md:grid-cols-2 xl:grid-cols-3">
							{/* Results inserted via JS */}
						</div>
						<div id="no-results" class="text-center py-16 hidden border border-dashed border-base-300 bg-base-200/30">
							<p class="text-lg font-serif italic text-base-content/50">No recipes found. Try a different search.</p>
						</div>
					</div>
				</div>
			</div>
		</main>
		<Footer />

		<script define:vars={{ recipesData }}>
			function initSearch() {
				const searchInput = document.getElementById('search-input');
				const resultsContainer = document.getElementById('results');
				const noResultsContainer = document.getElementById('no-results');

				if (!searchInput || !resultsContainer || !noResultsContainer) return;

				function renderRecipes(recipes) {
					resultsContainer.innerHTML = '';
					
					if (recipes.length === 0) {
						resultsContainer.classList.add('hidden');
						noResultsContainer.classList.remove('hidden');
						return;
					}

					resultsContainer.classList.remove('hidden');
					noResultsContainer.classList.add('hidden');

					recipes.forEach((recipe) => {
						const card = document.createElement('a');
						card.href = `/recipe/${recipe.id}`;
						card.className = 'group block border border-base-300 hover:border-primary transition-all duration-300 bg-base-100/50 hover:bg-base-200/20';
						card.innerHTML = `
							<div class="flex flex-col h-full">
								${recipe.heroImage ? `
									<div class="aspect-video w-full overflow-hidden border-b border-base-300 bg-base-200">
										<img 
											src="${recipe.heroImage}" 
											alt="${recipe.title}" 
											class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
											loading="lazy" 
											decoding="async" 
										/>
									</div>
								` : ''}
								<div class="p-6 flex-1 flex flex-col">
									<h3 class="text-xl font-bold font-serif group-hover:text-primary transition-colors leading-tight mb-3">${recipe.title}</h3>
									<p class="text-xs text-base-content/60 font-serif italic line-clamp-3 mb-6 flex-1">${recipe.description}</p>
									<div class="flex flex-wrap gap-2 mt-auto">
										${recipe.cuisine ? `<span class="bg-base-200/50 text-[9px] font-bold uppercase tracking-widest px-3 py-1.5 text-base-content/60 border border-base-300">${recipe.cuisine}</span>` : ''}
										${recipe.difficulty ? `<span class="bg-base-200/50 text-[9px] font-bold uppercase tracking-widest px-3 py-1.5 text-base-content/60 border border-base-300">${recipe.difficulty}</span>` : ''}
									</div>
									${recipe.rating ? `
										<div class="mt-5 pt-4 border-t border-base-200 flex items-center gap-1.5">
											<span class="text-primary">
												<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5">
													<path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
												</svg>
											</span>
											<span class="text-[9px] font-bold uppercase tracking-widest text-base-content/50">${recipe.rating}</span>
										</div>
									` : ''}
								</div>
							</div>
						`;
						resultsContainer.appendChild(card);
					});
				}

				function searchRecipes(query) {
					const lowerQuery = query.toLowerCase();
					
					if (!query.trim()) {
						renderRecipes(recipesData);
						return;
					}

					const results = recipesData.filter(recipe => {
						const searchText = `
							${recipe.title} 
							${recipe.description} 
							${recipe.cuisine} 
							${recipe.mealType} 
							${recipe.cookingMethod} 
							${recipe.ingredients}
							${recipe.dietaryTags.join(' ')}
						`.toLowerCase();
						
						return searchText.includes(lowerQuery);
					});

					renderRecipes(results);
				}

				// Initialize
				const urlParams = new URLSearchParams(window.location.search);
				const initialQuery = urlParams.get('q');
				
				if (initialQuery) {
					searchInput.value = initialQuery;
					searchRecipes(initialQuery);
				} else {
					renderRecipes(recipesData);
				}

				// Add search listener
				searchInput.addEventListener('input', (e) => {
					const query = e.target.value;
					searchRecipes(query);
					
					// Update URL without reloading
					const newUrl = new URL(window.location);
					if (query) {
						newUrl.searchParams.set('q', query);
					} else {
						newUrl.searchParams.delete('q');
					}
					window.history.replaceState({}, '', newUrl);
				});
			}

			// Run on initial load and after Astro View Transitions
			document.addEventListener('DOMContentLoaded', initSearch);
			document.addEventListener('astro:page-load', initSearch);
			
			// Fallback execution if DOMContentLoaded already fired
			if (document.readyState === 'interactive' || document.readyState === 'complete') {
				initSearch();
			}
		</script>
	</body>
</html>
