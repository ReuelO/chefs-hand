---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-[100] border-b border-base-300 bg-base-100">
	<div class="container mx-auto flex items-center justify-between px-6 py-3">
		<div class="flex items-center gap-12">
			<a href="/" class="group flex items-center gap-3 no-underline brand-logo cursor-pointer select-none">
				<div class="w-10 h-10 bg-base-content flex items-center justify-center text-base-100 font-serif italic text-xl transition-transform group-hover:scale-105">
					C
				</div>
				<h2 class="text-xl font-bold text-base-content font-serif uppercase tracking-[0.3em]">
					Chef's Hand
				</h2>
			</a>

			<nav class="hidden items-center gap-8 md:flex">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/recipes">Recipes</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
			</nav>
		</div>

		<div class="flex items-center gap-4">
			<a href="/recipes" class="p-2 transition-colors text-base-content hover:text-primary" aria-label="Search">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
					<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
				</svg>
			</a>
			<div class="hidden md:block">
				<ThemeToggle />
			</div>
			
			{/* Mobile Toggle */}
			<button id="mobile-menu-toggle" class="p-2 md:hidden text-base-content" aria-label="Toggle Menu">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
					<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
				</svg>
			</button>
		</div>
	</div>

	{/* Mobile Menu Drawer */}
	<div id="mobile-menu" class="fixed inset-0 z-[200] bg-base-100 p-8 flex flex-col gap-12 translate-x-full transition-transform duration-500 ease-out md:hidden">
		<div class="flex justify-between items-center border-b border-base-300 pb-6">
			<span class="text-xs uppercase tracking-[0.4em] font-bold text-primary">Menu</span>
			<button id="mobile-menu-close" class="p-2" aria-label="Close Menu">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
				</svg>
			</button>
		</div>
		<nav class="flex flex-col gap-8 text-4xl font-bold font-serif uppercase tracking-widest">
			<a href="/" class="hover:text-primary transition-colors">Home</a>
			<a href="/recipes" class="hover:text-primary transition-colors">Recipes</a>
			<a href="/blog" class="hover:text-primary transition-colors">Blog</a>
		</nav>
		<div class="mt-auto pt-8 border-t border-base-300 flex justify-between items-center">
			<ThemeToggle />
			<p class="text-[10px] font-bold uppercase tracking-widest text-base-content/40">© 2026 Chef's Hand</p>
		</div>
	</div>
</header>

<script>
	document.addEventListener('astro:page-load', () => {
		const toggle = document.getElementById('mobile-menu-toggle');
		const close = document.getElementById('mobile-menu-close');
		const menu = document.getElementById('mobile-menu');

		toggle?.addEventListener('click', () => {
			menu?.classList.remove('translate-x-full');
			document.body.style.overflow = 'hidden';
		});

		close?.addEventListener('click', () => {
			menu?.classList.add('translate-x-full');
			document.body.style.overflow = 'unset';
		});

		// Close menu on link click
		const links = menu?.querySelectorAll('a');
		links?.forEach(link => {
			link.addEventListener('click', () => {
				menu?.classList.add('translate-x-full');
				document.body.style.overflow = 'unset';
			});
		});

		// Double-click brand logo for Admin Access (Secured purely server-side)
		document.querySelectorAll('.brand-logo').forEach(logo => {
			logo.addEventListener('dblclick', async (e) => {
				e.preventDefault();
				const passcode = prompt('Enter Admin Passcode:');
				if (!passcode) return;

				try {
					const res = await fetch('/api/verify-passcode', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ passcode })
					});
					const data = await res.json();

					if (res.ok && data.success) {
						localStorage.setItem('admin_authorized', 'true');
						window.location.href = '/admin';
					} else {
						alert('Access Denied: Incorrect passcode.');
					}
				} catch (err) {
					console.error('Passcode verification failed:', err);
					alert('Authentication service is currently unavailable.');
				}
			});
		});
	});
</script>


