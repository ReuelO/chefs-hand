---
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
	currentRecipe: CollectionEntry<'recipes'>;
	maxRecipes?: number;
}

const { currentRecipe, maxRecipes = 3 } = Astro.props;

const allRecipes = await getCollection('recipes');

// Find related recipes based on shared tags/cuisine/meal type
const relatedRecipes = allRecipes
	.filter(recipe => recipe.id !== currentRecipe.id)
	.map(recipe => {
		let score = 0;
		if (recipe.data.cuisine === currentRecipe.data.cuisine) score += 3;
		if (recipe.data.mealType === currentRecipe.data.mealType) score += 2;
		if (recipe.data.cookingMethod === currentRecipe.data.cookingMethod) score += 2;
		if (
			recipe.data.dietaryTags?.some(tag =>
				currentRecipe.data.dietaryTags?.includes(tag)
			)
		) score += 1;
		return { recipe, score };
	})
	.filter(item => item.score > 0)
	.sort((a, b) => b.score - a.score)
	.slice(0, maxRecipes)
	.map(item => item.recipe);

if (relatedRecipes.length === 0) {
	return null;
}
---

<div class="mt-24 pt-16 border-t border-base-300">
	<h2 class="text-3xl font-bold mb-12 font-serif text-center uppercase tracking-widest">You May Also Like</h2>
	<div class="grid gap-12 grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-base-300">
		{relatedRecipes.map(recipe => (
			<a
				href={`/recipe/${recipe.id}`}
				class="group block md:px-8 first:pl-0 last:pr-0 py-8 md:py-0 transition-colors hover:bg-base-200/30"
			>
				<div>
					<div class="flex items-center gap-2 mb-4">
						{recipe.data.cuisine && (
							<span class="text-[10px] uppercase tracking-widest text-primary font-bold">{recipe.data.cuisine}</span>
						)}
					</div>
					<h3 class="text-2xl font-bold mb-3 font-serif group-hover:text-primary transition-colors leading-tight">{recipe.data.title}</h3>
					<p class="text-sm text-base-content/70 line-clamp-2 leading-relaxed font-serif italic">{recipe.data.description}</p>
					
					{recipe.data.rating && (
						<div class="mt-6 flex items-center gap-1.5 pt-6 border-t border-base-300">
							<span class="text-primary font-bold">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
									<path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
								</svg>
							</span>
							<span class="text-xs font-bold uppercase tracking-widest text-base-content/50">{recipe.data.rating}</span>
						</div>
					)}
				</div>
			</a>
		))}
	</div>
</div>

