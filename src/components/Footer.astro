---
const today = new Date();
import preferences from '../data/preferences.json';
---

<footer class="bg-base-100 py-24 border-t border-base-300 mt-auto">
	<div class="container mx-auto px-6">
		<div class="grid md:grid-cols-3 gap-12 mb-16">
			<div class="col-span-2">
				<div class="flex items-center gap-3 mb-6 brand-logo cursor-pointer select-none">
					<div class="w-8 h-8 bg-base-content flex items-center justify-center text-base-100 font-serif italic text-sm">C</div>
					<h2 class="text-xl font-bold font-serif uppercase tracking-[0.3em] text-base-content">Chef's Hand</h2>
				</div>
				<p class="text-base-content/60 max-w-sm leading-relaxed font-serif italic">
					{preferences.brandSubtitle}
				</p>
			</div>
			
			<div>
				<h3 class="text-[10px] uppercase tracking-[0.3em] font-bold text-base-content/40 mb-6">Explore</h3>
				<ul class="space-y-4 text-xs uppercase tracking-widest font-semibold mt-6">
					<li><a href="/" class="text-base-content/60 hover:text-primary transition-colors">Home</a></li>
					<li><a href="/recipes" class="text-base-content/60 hover:text-primary transition-colors">Recipes</a></li>
					<li><a href="/blog" class="text-base-content/60 hover:text-primary transition-colors">Blog</a></li>
					<li><a href="/rss.xml" class="text-base-content/60 hover:text-primary transition-colors flex items-center gap-2" target="_blank">
						RSS Feed 
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3">
							<path fill-rule="evenodd" d="M3.75 4.5a.75.75 0 0 1 .75-.75h.75c8.284 0 15 6.716 15 15v.75a.75.75 0 0 1-.75.75h-.75a.75.75 0 0 1-.75-.75v-.75C17.17 11.708 12.292 6.83 6.25 6.83h-.75a.75.75 0 0 1-.75-.75v-.75Zm0 6.5a.75.75 0 0 1 .75-.75h.75a8.25 8.25 0 0 1 8.25 8.25v.75a.75.75 0 0 1-.75.75H12a.75.75 0 0 1-.75-.75v-.75a6.75 6.75 0 0 0-6.75-6.75h-.75a.75.75 0 0 1-.75-.75v-.75Zm0 6.5a.75.75 0 0 1 .75-.75h.75a1.75 1.75 0 0 1 1.75 1.75v.75a.75.75 0 0 1-.75.75h-.75a.75.75 0 0 1-.75-.75v-.75Z" clip-rule="evenodd" />
						</svg>
					</a></li>
				</ul>
			</div>
		</div>

		<div class="pt-8 border-t border-base-300 text-center text-[10px] font-bold uppercase tracking-[0.2em] text-base-content/40">
			<p>&copy; {today.getFullYear()} Chef&apos;s Hand. Crafted with intention.</p>
		</div>
	</div>
</footer>

